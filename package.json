{
  "name": "dhd-consulting-website",
  "version": "1.0.0",
  "description": "DHD Consulting website with SCSS auto-compilation",
  "scripts": {
    "dev": "sass --watch styles/main.scss:styles/main.css --style=expanded",
    "build": "sass styles/main.scss:styles/main.css --style=compressed",
    "build:expanded": "sass styles/main.scss:styles/main.css --style=expanded",
    "serve": "live-server --port=8000 --wait=500",
    "start": "npm-run-all --parallel dev serve"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.69.5"
  },
  "keywords": [
    "dhd",
    "consulting",
    "website"
  ],
  "author": "DHD Consulting",
  "license": "ISC"
}
